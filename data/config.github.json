          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 40,
          "category": "vibecoding",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 8
    },
    "ossinsight": {
      "enabled": false
    },
    "github": [],
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 25,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "ai-creator"
    ],
    "category_groups": {
      "ai-vibe": {
        "name": "AI 工具 / Vibe Coding",
        "limit": 7,
        "categories": [
          "ai-tools",
          "vibecoding"
        ]
      },
      "web3": {
        "name": "Web3",
        "limit": 5,
        "categories": [
          "web3"
        ]
      },
      "product": {
        "name": "产品",
        "limit": 4,
        "categories": [
          "product"
        ]
      },
      "creator": {
        "name": "自媒体",
        "limit": 4,
        "categories": [
          "creator"
        ]
      },
      "tech": {
        "name": "科技 / 技术方向",
        "limit": 5,
        "categories": [
          "tech"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false
  },
  "wechat": {
    "enabled": false
  }
